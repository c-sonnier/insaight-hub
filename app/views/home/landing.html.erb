  .landing .g-card { width:300px; border-radius:14px; overflow:hidden; border:1px solid var(--line); background:#fff; box-shadow:0 10px 30px rgba(16,50,91,.1); transition:transform .25s; }
  .landing .g-card:hover { transform:translateY(-5px) scale(1.02); }
