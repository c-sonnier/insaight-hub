  .landing footer.lfoot { background:var(--navy); border-top:1px solid rgba(232,242,251,.12); padding:30px 24px; color:rgba(232,242,251,.65); font-size:13.5px; }
  .landing footer.lfoot .f-in { max-width:1140px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
  .landing footer.lfoot .brand { color:#fff; font-size:15px; }
