</div>

<script>
(function(){
  function initLanding(){
  /* ---------- mini browser ---------- */
  const root = document.getElementById('mb1');
  // Guard with an element property, not an attribute: Turbo's page cache clones
  // the DOM (keeping attributes, dropping listeners), so an attribute guard
  // would block re-wiring after a restoration visit.
  if (!root || root._wired) return;
  root._wired = true;

  const views = {};
  root.querySelectorAll('.mb-view').forEach(v => views[v.dataset.view] = v);
  const skel = root.querySelector('.skel');
  const path = root.querySelector('.mb-path');
  const back = root.querySelector('.mb-back');
  const bar = root.querySelector('.mb-loadbar');
  const hint = root.querySelector('.try-hint');
  let current = 'dashboard', busy = false;

  function navigate(to, url){
    if (busy || to === current) return; busy = true;
    if (hint) hint.classList.add('gone');
    bar.style.opacity = 1; bar.style.width = '55%';
    views[current].classList.add('fading');
    setTimeout(()=>{
      views[current].classList.add('hidden');
      skel.classList.add('on');
      path.textContent = url;
      setTimeout(()=>{
        bar.style.width = '100%';
        skel.classList.remove('on');
        const v = views[to];
        v.classList.remove('hidden','fading');
        v.scrollTop = 0;
        current = to;
        back.disabled = (to === 'dashboard');
        v.querySelectorAll('.rv-stage').forEach(s=>{ s.classList.remove('on'); void s.offsetWidth; s.classList.add('on'); });
        v.querySelectorAll('.bar-t').forEach(b=>{ b.style.width = 0; setTimeout(()=> b.style.width = b.dataset.w, 60); });
        setTimeout(()=>{ bar.style.opacity = 0; bar.style.width = '0'; busy = false; }, 260);
      }, 620);
    }, 200);
  }

  function closePops(except){
    root.querySelectorAll('.pop.open').forEach(p=>{ if(p !== except) p.classList.remove('open'); });
  }

  root.addEventListener('click', e=>{
    const orgToggle = e.target.closest('[data-org-toggle]');
    if (orgToggle){
      const pop = orgToggle.parentElement.querySelector('.pop');
      closePops(pop); pop.classList.toggle('open'); return;
    }
    const orgOpt = e.target.closest('.org-opt');
    if (orgOpt){
      root.querySelector('.org-ava').style.background = orgOpt.dataset.color;
      root.querySelector('.org-ava').textContent = orgOpt.dataset.init;
      root.querySelector('.org-name').textContent = orgOpt.dataset.org;
      orgOpt.parentElement.querySelectorAll('.org-opt').forEach(o=>o.classList.toggle('current', o===orgOpt));
      closePops(); return;
    }
    const bell = e.target.closest('[data-bell]');
    if (bell){
      const pop = bell.parentElement.querySelector('.pop');
      closePops(pop); pop.classList.toggle('open'); return;
    }
    const mark = e.target.closest('.np-mark');
    if (mark){
      root.querySelectorAll('.np-row').forEach(r=>r.classList.add('read'));
      const ping = root.querySelector('.bell .ping');
      if (ping) ping.style.display = 'none';
      return;
    }
    if (e.target.closest('.pop')) return;
    closePops();
    const card = e.target.closest('.icard[data-target]');
    if (card){ navigate(card.dataset.target, card.dataset.path); return; }
    if (e.target.closest('.mb-backlink') || e.target.closest('.mb-back:not(:disabled)')){
      navigate('dashboard','/dashboard');
    }
  });

  /* ---------- scroll reveal ---------- */
  const io = new IntersectionObserver(entries=>{
    entries.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('on'); io.unobserve(en.target); } });
  },{threshold:.2});
  document.querySelectorAll('.landing .rv, .landing .fviz.rv-stage').forEach(el=>io.observe(el));

  /* ---------- typing terminal ---------- */
  const term = document.getElementById('typeterm');
  const typed = document.getElementById('typed');
  const caret = document.getElementById('caret');
  if (term && typed && !typed.textContent.length){
    const lines = term.querySelectorAll('.tline');
    const msg = 'save this churn analysis as an insight for stakeholders';
    let started = false;
    const tio = new IntersectionObserver(en=>{
      if(en[0].isIntersecting && !started){
        started = true; tio.disconnect();
        let i = 0;
        const t = setInterval(()=>{
          typed.textContent = msg.slice(0, ++i);
          if(i >= msg.length){
            clearInterval(t); caret.style.display = 'none';
            lines.forEach((l,idx)=> setTimeout(()=> l.classList.add('show'), 350 + idx*380));
          }
        }, 32);
      }
    },{threshold:.5});
    tio.observe(term);
  }

  /* ---------- gallery marquee ---------- */
  const track = document.getElementById('gtrack');
  if (track && !track.dataset.dup){ track.dataset.dup = '1'; track.innerHTML += track.innerHTML; }
  }

  initLanding();
  if (!window._landingTurboHook){
    window._landingTurboHook = true;
    document.addEventListener('turbo:load', initLanding);
  }
})();
</script>
