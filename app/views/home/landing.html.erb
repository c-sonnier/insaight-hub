  .landing .term { background:#0b1220; border-radius:13px; padding:20px; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:12.5px; line-height:1.8; color:#94a3b8; box-shadow:0 20px 60px rgba(0,0,0,.35); }
