  .landing footer.lfoot a.lic:hover { color:var(--sky); }

  @media (max-width:960px) {
    .landing .frow { grid-template-columns:1fr; gap:32px; }
    .landing .frow.rev > .fviz { order:0; }
    .landing .hlinks { display:none; }
    .landing .cards { grid-template-columns:1fr; }
    .landing .stat-row { grid-template-columns:1fr; }
    .landing .mini-feats { grid-template-columns:1fr; }
    .landing .lux-cols { grid-template-columns:1fr; }
    .landing .cyb-flow { flex-direction:column; }
    .landing .cyb-link { flex:0 0 24px; width:2px; height:24px; background:repeating-linear-gradient(180deg,#22d3ee 0 6px,transparent 6px 12px); }
  }
</style>

