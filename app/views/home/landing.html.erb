<%
  page_title "Transform AI Output into Shared Understanding"
  page_description "insAIght Hub transforms scattered AI output into structured, searchable, and actionable knowledge. Capture, organize, and share AI insights with your team."
  page_keywords "AI insights, knowledge management, team collaboration, AI documentation, MCP integration, Claude, Cursor"
%>

<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@1,500;1,600&family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<% end %>

<style>
  .landing { font-family:'Inter',system-ui,sans-serif; color:#0f172a; background:#fff; -webkit-font-smoothing:antialiased;
    --navy:#10325B; --navy-2:#183C67; --navy-3:#1e4a7d;
    --sky:#33B8ED; --yellow:#FBE766; --orange:#FCC64E; --green:#A1D555; --purple:#6772D1; --red:#EB413D;
    --emerald:#10B981; --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --lbg:#f8fafc; }
  .landing * { margin:0; padding:0; box-sizing:border-box; }
  .landing .serif-i { font-family:'Source Serif 4',Georgia,serif; font-style:italic; font-weight:600; }
  .landing .wrap { max-width:1140px; margin:0 auto; padding:0 24px; }
  .landing a { text-decoration:none; color:inherit; }
  .landing .lbtn { display:inline-flex; align-items:center; gap:8px; font-weight:600; border-radius:12px; cursor:pointer; border:none; transition:all .2s; font-size:16px; }
  .landing .lbtn-sky { background:var(--sky); color:#062a44; padding:14px 30px; font-weight:700; box-shadow:0 6px 24px rgba(51,184,237,.45); }
  .landing .lbtn-sky:hover { background:#5cc9f3; transform:translateY(-1px); box-shadow:0 10px 30px rgba(51,184,237,.5); }
  .landing .lbtn-ghost-w { color:#e8f2fb; padding:14px 28px; border:1px solid rgba(232,242,251,.35); }
  .landing .lbtn-ghost-w:hover { border-color:var(--sky); color:var(--sky); }
  .landing .logo-mark { display:block; }
  .landing .brand { display:flex; align-items:center; gap:10px; font-weight:800; font-size:18px; letter-spacing:-.01em; }
  .landing .brand .ai { color:var(--sky); }

  /* scroll reveal */
  .landing .rv { opacity:0; transform:translateY(22px); transition:opacity .7s cubic-bezier(.22,.7,.3,1), transform .7s cubic-bezier(.22,.7,.3,1); }
  .landing .rv.on { opacity:1; transform:none; }
  .landing .rv.d1 { transition-delay:.08s; } .landing .rv.d2 { transition-delay:.16s; }

  /* ============ HERO ============ */
  .landing .lhero { position:relative; color:#e8f2fb; }
  .landing .hero-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none;
    background:linear-gradient(180deg, #0d2947 0%, var(--navy) 55%, var(--navy-2) 100%); }
  .landing .aurora { position:absolute; inset:-20% -10%; pointer-events:none; filter:blur(70px); opacity:.5; }
  .landing .aurora i { position:absolute; border-radius:50%; }
  .landing .aurora .a1 { width:520px; height:340px; left:6%; top:8%; background:rgba(51,184,237,.5); animation:ld-drift1 16s ease-in-out infinite; }
  .landing .aurora .a2 { width:380px; height:280px; right:8%; top:2%; background:rgba(103,114,209,.45); animation:ld-drift2 19s ease-in-out infinite; }
  .landing .aurora .a3 { width:300px; height:220px; right:26%; top:34%; background:rgba(252,198,78,.28); animation:ld-drift1 22s ease-in-out infinite reverse; }
  .landing .aurora .a4 { width:260px; height:200px; left:24%; top:40%; background:rgba(161,213,85,.22); animation:ld-drift2 24s ease-in-out infinite reverse; }
  @keyframes ld-drift1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(60px,30px) scale(1.12)} }
  @keyframes ld-drift2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-50px,40px) scale(1.08)} }
  .landing .hero-bg::before { content:""; position:absolute; inset:0;
    background-image:radial-gradient(rgba(232,242,251,.10) 1px, transparent 1px);
    background-size:30px 30px;
    mask-image:linear-gradient(180deg, rgba(0,0,0,.6), transparent 75%);
    -webkit-mask-image:linear-gradient(180deg, rgba(0,0,0,.6), transparent 75%); }

  .landing nav.hero-nav { position:relative; z-index:20; }
  .landing .nav-in { display:flex; align-items:center; justify-content:space-between; height:80px; }
  .landing .brand-hero { color:#fff; }
  .landing .hlinks { display:flex; gap:28px; align-items:center; font-size:14.5px; font-weight:500; color:rgba(232,242,251,.7); }
  .landing .hlinks a:hover { color:#fff; }
  .landing .btn-nav { background:rgba(51,184,237,.14); color:var(--sky); padding:9px 20px; border-radius:10px; font-size:14px; font-weight:600; border:1px solid rgba(51,184,237,.35); transition:all .2s; }
  .landing .btn-nav:hover { background:rgba(51,184,237,.25); }

  .landing .hero-copy { position:relative; z-index:10; text-align:center; padding:64px 24px 24px; }
  .landing .pill-note { display:inline-flex; align-items:center; gap:9px; font-size:13px; font-weight:600; color:var(--sky); background:rgba(51,184,237,.1); border:1px solid rgba(51,184,237,.3); padding:7px 16px; border-radius:22px; margin-bottom:26px; animation:ld-rise .8s cubic-bezier(.22,.7,.3,1) both; }
  .landing .pill-note .pdot { width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); animation:ld-pulse 2s infinite; }
  @keyframes ld-pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
  .landing .hero-copy h1 { font-size:clamp(38px,5.4vw,62px); font-weight:800; letter-spacing:-.03em; line-height:1.12; color:#fff; animation:ld-rise .8s .1s cubic-bezier(.22,.7,.3,1) both; }
  .landing .hw-sky { color:#7dd3f5; }
  .landing .hw-amber { color:var(--orange); }
  .landing .hero-copy p.lede { margin:22px auto 0; max-width:580px; font-size:19px; line-height:1.6; color:rgba(232,242,251,.72); animation:ld-rise .8s .2s cubic-bezier(.22,.7,.3,1) both; }
  .landing .hero-ctas { display:flex; gap:14px; justify-content:center; margin-top:34px; animation:ld-rise .8s .3s cubic-bezier(.22,.7,.3,1) both; }
  @keyframes ld-rise { from{opacity:0; transform:translateY(26px)} to{opacity:1; transform:none} }

  .landing .stage { position:relative; z-index:10; padding:60px 24px 96px; animation:ld-rise .9s .42s cubic-bezier(.22,.7,.3,1) both; }

  /* ============ MINI BROWSER ============ */
  .landing .mini-browser { max-width:1000px; margin:0 auto; background:#fff; border-radius:18px; overflow:hidden;
    border:1px solid rgba(16,50,91,.12);
    box-shadow:0 0 0 8px rgba(232,242,251,.08), 0 40px 100px rgba(4,16,32,.55), 0 12px 30px rgba(4,16,32,.35); }
  .landing .mb-chrome { display:flex; align-items:center; gap:12px; padding:12px 16px; background:#f1f5f9; border-bottom:1px solid var(--line); position:relative; }
  .landing .dots { display:flex; gap:7px; }
  .landing .dot { width:12px; height:12px; border-radius:50%; }
  .landing .mb-nav { display:flex; gap:6px; }
  .landing .mb-nav button { width:26px; height:26px; border-radius:8px; border:none; background:transparent; color:#94a3b8; cursor:pointer; display:grid; place-items:center; }
  .landing .mb-nav button:not(:disabled):hover { background:#e2e8f0; color:var(--navy); }
  .landing .mb-nav button:disabled { opacity:.4; cursor:default; }
  .landing .mb-url { flex:1; display:flex; align-items:center; gap:8px; background:#fff; border:1px solid var(--line); border-radius:9px; padding:6px 12px; font-size:13px; color:var(--muted); font-weight:500; }
  .landing .mb-url .lock { color:var(--emerald); }
  .landing .mb-url .path { color:var(--ink); }
  .landing .mb-loadbar { position:absolute; bottom:-1px; left:0; height:3px; width:0; background:linear-gradient(90deg,var(--sky),#0ea5e9); z-index:5; transition:width .35s ease; opacity:0; }
  .landing .mb-viewport { position:relative; height:620px; overflow:hidden; background:var(--lbg); }
  .landing .mb-view { position:absolute; inset:0; overflow-y:auto; opacity:1; transition:opacity .25s ease; }
  .landing .mb-view.hidden { display:none; }
  .landing .mb-view.fading { opacity:0; }
  .landing .try-hint { position:absolute; bottom:16px; left:50%; transform:translateX(-50%); background:var(--navy); color:#fff; font-size:12.5px; font-weight:600; padding:9px 18px; border-radius:22px; box-shadow:0 8px 22px rgba(16,50,91,.35); pointer-events:none; display:flex; gap:8px; align-items:center; animation:ld-bob 2.2s ease-in-out infinite; z-index:6; }
  @keyframes ld-bob { 0%,100%{transform:translate(-50%,0)} 50%{transform:translate(-50%,-6px)} }
  .landing .try-hint.gone { display:none; }

  .landing .skel { position:absolute; inset:0; padding:26px 30px; background:var(--lbg); display:none; z-index:4; }
  .landing .skel.on { display:block; }
  .landing .sk { border-radius:8px; background:linear-gradient(90deg,#e8eef5 25%,#f3f7fb 50%,#e8eef5 75%); background-size:200% 100%; animation:ld-shimmer 1.1s infinite; }
  @keyframes ld-shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

  /* --- dashboard --- */
  .landing .dash { padding:24px 28px; }
  .landing .app-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
  .landing .app-top .who { font-size:21px; font-weight:800; color:var(--ink); }
  .landing .app-top .sub { font-size:13px; color:var(--muted); margin-top:2px; }
  .landing .app-icons { display:flex; align-items:center; gap:12px; }
  .landing .bell { position:relative; width:34px; height:34px; border-radius:10px; background:#fff; border:1px solid var(--line); display:grid; place-items:center; color:var(--muted); cursor:pointer; }
  .landing .bell .ping { position:absolute; top:-4px; right:-4px; min-width:17px; height:17px; padding:0 4px; border-radius:9px; background:var(--red); color:#fff; font-size:10px; font-weight:700; display:grid; place-items:center; border:2px solid var(--lbg); }
  .landing .org-chip { display:flex; align-items:center; gap:7px; background:#fff; border:1px solid var(--line); border-radius:10px; padding:6px 11px; font-size:12.5px; font-weight:600; color:var(--navy); cursor:pointer; }
  .landing .org-chip .avatar-sm { width:19px; height:19px; border-radius:6px; background:var(--navy); color:#fff; font-size:9px; font-weight:700; display:grid; place-items:center; }

  .landing .menu-wrap { position:relative; }
  .landing .pop { position:absolute; top:calc(100% + 8px); right:0; background:#fff; border:1px solid var(--line); border-radius:12px; box-shadow:0 18px 44px rgba(16,50,91,.2); z-index:20; opacity:0; transform:translateY(-6px); pointer-events:none; transition:all .18s ease; }
  .landing .pop.open { opacity:1; transform:none; pointer-events:auto; }
  .landing .org-pop { width:200px; padding:6px; }
  .landing .org-opt { display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:8px; font-size:12.5px; font-weight:600; color:var(--ink); cursor:pointer; }
  .landing .org-opt:hover { background:#f1f5f9; }
  .landing .org-opt .avatar-sm { width:19px; height:19px; border-radius:6px; color:#fff; font-size:9px; font-weight:700; display:grid; place-items:center; }
  .landing .org-opt .chk { margin-left:auto; color:var(--emerald); display:none; }
  .landing .org-opt.current .chk { display:block; }
  .landing .notif-pop { width:312px; padding:10px 12px 6px; }
  .landing .np-head { display:flex; align-items:center; justify-content:space-between; padding:2px 4px 8px; }
  .landing .np-head b { font-size:13px; color:var(--navy); }
  .landing .np-mark { font-size:11.5px; font-weight:600; color:#0284c7; cursor:pointer; }
  .landing .np-row { display:flex; gap:9px; align-items:flex-start; padding:9px 6px; border-top:1px solid #f1f5f9; font-size:11.5px; line-height:1.45; color:#475569; }
  .landing .np-row b { color:var(--ink); }
  .landing .np-dot { width:7px; height:7px; border-radius:50%; background:var(--sky); flex-shrink:0; margin-top:4px; transition:opacity .3s; }
  .landing .np-row.read .np-dot { opacity:0; }
  .landing .np-when { margin-left:auto; color:#94a3b8; font-size:10.5px; white-space:nowrap; }

  .landing .stat-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:22px; }
  .landing .lstat { display:flex; align-items:center; justify-content:space-between; background:#fff; border:1px solid var(--line); border-radius:14px; padding:15px 18px; box-shadow:0 1px 3px rgba(16,50,91,.05); }
  .landing .lstat .k { font-size:11.5px; font-weight:600; color:var(--muted); }
  .landing .lstat .v { font-size:26px; font-weight:800; margin-top:1px; }
  .landing .lstat .d { font-size:11.5px; color:var(--muted); }
  .landing .lstat svg { flex-shrink:0; }

  .landing .sec-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .landing .sec-head .t { font-size:16px; font-weight:800; color:var(--ink); }
  .landing .sec-head .all { font-size:12.5px; font-weight:600; color:#0284c7; cursor:pointer; }
  .landing .cards { display:grid; grid-template-columns:1fr 1fr; gap:16px; padding-bottom:26px; }
  .landing .icard { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; cursor:pointer; transition:all .2s; box-shadow:0 1px 3px rgba(16,50,91,.06); }
  .landing .icard:hover { box-shadow:0 14px 34px rgba(16,50,91,.16); transform:translateY(-3px); border-color:#cbd5e1; }
  .landing .icard .cbody { padding:13px 15px 14px; }
  .landing .icard h4 { font-size:14.5px; font-weight:700; color:var(--ink); }
  .landing .icard p { font-size:12.5px; color:var(--muted); margin-top:3px; line-height:1.45; }
  .landing .icard .meta { display:flex; align-items:center; gap:6px; margin-top:9px; flex-wrap:wrap; }
  .landing .badge-l { font-size:10.5px; font-weight:600; padding:2.5px 9px; border-radius:20px; border:1px solid var(--line); color:var(--muted); }
  .landing .badge-l.outline { border-color:#cbd5e1; color:#475569; }
  .landing .badge-l.ghost { border-color:transparent; background:#f1f5f9; }
  .landing .cfoot { display:flex; align-items:center; justify-content:space-between; margin-top:11px; }
  .landing .cwho { display:flex; align-items:center; gap:7px; font-size:11px; color:#94a3b8; }
  .landing .cava { width:20px; height:20px; border-radius:50%; color:#fff; font-size:8.5px; font-weight:700; display:grid; place-items:center; flex-shrink:0; }
  .landing .view-btn { font-size:11px; font-weight:700; background:var(--navy-2); color:#fff; padding:5px 13px; border-radius:8px; }

  /* --- thumbnails --- */
  .landing .thumb { aspect-ratio:16/9; position:relative; overflow:hidden; border-bottom:1px solid var(--line); }
  .landing .th-term { background:#0b0f0c; padding:12px 14px; font-family:'JetBrains Mono',monospace; }
  .landing .th-term .tl { font-size:9.5px; color:#33ff66; line-height:1.75; white-space:nowrap; }
  .landing .th-term .tl b { color:#a3ffbe; font-weight:600; }
  .landing .th-term .dim { color:#1f7a3a; }
  .landing .th-term .amber { color:#ffc266; }
  .landing .th-term .cursor { display:inline-block; width:6px; height:11px; background:#33ff66; vertical-align:-2px; }
  .landing .th-bars { display:flex; align-items:flex-end; gap:5px; height:34px; margin-top:6px; }
  .landing .th-bars i { width:14px; background:#1f7a3a; }
  .landing .th-bars i.hot { background:#33ff66; box-shadow:0 0 8px rgba(51,255,102,.7); }
  .landing .th-brut { background:#FFF4D6; padding:11px 13px; }
  .landing .th-brut .bt { font-weight:800; font-size:13px; text-transform:uppercase; letter-spacing:-.02em; color:#111; }
  .landing .th-brut .funnel { margin-top:8px; display:flex; flex-direction:column; gap:4px; }
  .landing .th-brut .fb { height:13px; border:2px solid #111; box-shadow:3px 3px 0 #111; font-size:7px; font-weight:800; display:flex; align-items:center; padding-left:5px; color:#111; }
  .landing .th-brut .stkr { position:absolute; right:8px; top:8px; background:#EB413D; color:#fff; border:2px solid #111; font-weight:800; font-size:8.5px; padding:3px 7px; transform:rotate(6deg); box-shadow:2px 2px 0 #111; }
  .landing .th-lux { background:#FAF7F0; padding:12px 16px; text-align:center; }
  .landing .th-lux .rule { width:36px; height:1px; background:#B08D3E; margin:4px auto; }
  .landing .th-lux .lk { font-size:7px; letter-spacing:.28em; text-transform:uppercase; color:#8a7440; font-weight:600; }
  .landing .th-lux .num { font-family:'Playfair Display',serif; font-size:38px; color:#1d1a14; line-height:1.05; }
  .landing .th-lux .sub { font-family:'Playfair Display',serif; font-style:italic; font-size:9.5px; color:#6b5d3f; }
  .landing .th-ind { background:#232527; padding:0; }
  .landing .th-ind .hz { height:9px; background:repeating-linear-gradient(-45deg,#FF5A00 0 8px,#232527 8px 16px); }
  .landing .th-ind .inn { padding:9px 13px; font-family:'JetBrains Mono',monospace; }
  .landing .th-ind .lbl { font-size:7.5px; letter-spacing:.18em; color:#8b9096; }
  .landing .th-ind .big { font-size:21px; font-weight:700; color:#fff; margin-top:2px; }
  .landing .th-ind .big b { color:#FF5A00; }
  .landing .th-ind .plates { display:flex; gap:5px; margin-top:7px; }
  .landing .th-ind .pl { flex:1; background:#2e3134; border:1px solid #3c4043; border-top:2px solid #FF5A00; color:#c9ced4; font-size:7px; padding:4px 5px; }
  .landing .th-cyb { background:radial-gradient(120% 100% at 50% 0%, #1a0b33 0%, #0c0618 70%); padding:11px 14px; }
  .landing .th-cyb .ct { font-family:'JetBrains Mono',monospace; font-size:9px; color:#22d3ee; text-shadow:0 0 8px rgba(34,211,238,.8); }
  .landing .th-cyb .flow { display:flex; align-items:center; gap:6px; margin-top:12px; }
  .landing .th-cyb .node { border:1px solid #22d3ee; color:#a5f3fc; font-family:'JetBrains Mono',monospace; font-size:7.5px; padding:5px 7px; border-radius:4px; box-shadow:0 0 10px rgba(34,211,238,.35), inset 0 0 8px rgba(34,211,238,.12); }
  .landing .th-cyb .node.pink { border-color:#f472b6; color:#fbcfe8; box-shadow:0 0 10px rgba(244,114,182,.35), inset 0 0 8px rgba(244,114,182,.12); }
  .landing .th-cyb .lnk { flex:1; height:1px; background:linear-gradient(90deg,#22d3ee,#f472b6); box-shadow:0 0 6px rgba(34,211,238,.6); }
  .landing .th-cyb .gridfloor { position:absolute; left:0; right:0; bottom:0; height:34%;
    background-image:linear-gradient(rgba(244,114,182,.25) 1px, transparent 1px), linear-gradient(90deg, rgba(244,114,182,.25) 1px, transparent 1px);
    background-size:22px 12px; transform:perspective(80px) rotateX(50deg); transform-origin:bottom; }

  /* --- insight show pages --- */
  .landing .show-bar { display:flex; align-items:center; gap:12px; padding:12px 20px; background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:3; }
  .landing .show-bar .bk { display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; color:#0284c7; cursor:pointer; }
  .landing .show-bar .tt { font-size:13.5px; font-weight:700; color:var(--ink); }
  .landing .show-bar .badges { margin-left:auto; display:flex; gap:6px; }
  .landing .artifact { min-height:340px; }
  .landing .discuss { padding:20px 24px 30px; background:var(--lbg); border-top:1px solid var(--line); }
  .landing .discuss h5 { font-size:12px; font-weight:700; color:var(--navy); text-transform:uppercase; letter-spacing:.05em; margin-bottom:12px; }
  .landing .cmt { display:flex; gap:10px; padding:11px 0; border-top:1px solid #eef2f7; }
  .landing .cmt:first-of-type { border-top:none; padding-top:0; }
  .landing .cmt .cw { font-size:12.5px; font-weight:700; color:var(--ink); }
  .landing .cmt .cb { font-size:12.5px; color:var(--muted); line-height:1.5; margin-top:1px; }
  .landing .cmt .cava { width:27px; height:27px; font-size:10px; }

  /* artifact style: TERMINAL */
  .landing .art-term { background:#0b0f0c; color:#33ff66; font-family:'JetBrains Mono',monospace; padding:26px 30px; font-size:13px; line-height:1.8; }
  .landing .art-term .path { color:#1f7a3a; }
  .landing .art-term h2 { color:#a3ffbe; font-size:15px; font-weight:700; margin:18px 0 4px; }
  .landing .art-term h2::before { content:"## "; color:#1f7a3a; }
  .landing .art-term .amber { color:#ffc266; }
  .landing .art-term .red { color:#ff6b5e; }
  .landing .art-term .dim { color:#2ea152; opacity:.75; }
  .landing .term-chart { margin:10px 0 6px; }
  .landing .term-chart .row { display:flex; align-items:center; gap:10px; font-size:12px; margin:3px 0; }
  .landing .term-chart .lb { width:34px; color:#2ea152; }
  .landing .term-chart .bar-t { height:13px; background:#1f7a3a; transition:width 1s cubic-bezier(.22,.7,.3,1); width:0; }
