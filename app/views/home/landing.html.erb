  .landing .term .caret { display:inline-block; width:7px; height:13px; background:#e2e8f0; vertical-align:-2px; animation:ld-blink 1s steps(1) infinite; }

  /* canvas gallery */
  .landing .gallery { padding:92px 0 84px; background:linear-gradient(180deg,#fff, #f4f9fe); overflow:hidden; }
