  .landing .ind-gauge .g2 { font-size:44px; font-weight:700; color:#FF5A00; }
  .landing .ind-gauge .gl { font-size:10px; color:#8b9096; letter-spacing:.14em; margin-left:auto; align-self:center; text-align:right; line-height:1.6; }
