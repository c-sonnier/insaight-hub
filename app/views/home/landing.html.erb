  .landing .mf h4 { font-size:15.5px; font-weight:700; color:var(--navy); margin:12px 0 6px; }
  .landing .mf p { font-size:13.5px; color:var(--muted); line-height:1.55; }
  .landing .mf .ic { width:36px; height:36px; border-radius:10px; display:grid; place-items:center; }

  /* CTA + footer */
  .landing .cta-final { position:relative; overflow:hidden; text-align:center; padding:104px 24px; color:#fff;
    background:linear-gradient(180deg,var(--navy-2),var(--navy)); }
  .landing .cta-final::before { content:""; position:absolute; inset:0; background:radial-gradient(600px 320px at 50% 0%, rgba(51,184,237,.25), transparent 65%); }
  .landing .cta-final h2 { position:relative; font-size:clamp(30px,4vw,46px); font-weight:800; letter-spacing:-.03em; }
