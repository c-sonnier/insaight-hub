  .landing .rv-stage.on .notif-row { opacity:1; transform:none; }
  .landing .rv-stage.on .notif-row:nth-child(3){transition-delay:.12s} .landing .rv-stage.on .notif-row:nth-child(4){transition-delay:.24s} .landing .rv-stage.on .notif-row:nth-child(5){transition-delay:.36s} .landing .rv-stage.on .notif-row:nth-child(6){transition-delay:.48s}
  .landing .notif-row:last-child { border-bottom:none; }
