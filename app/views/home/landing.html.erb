  /* mini features */
  .landing .mini-feats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:52px; }
  .landing .mf { border:1px solid var(--line); border-radius:14px; padding:22px; background:#fff; transition:all .25s; }
