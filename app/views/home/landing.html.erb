  .landing .bf { border:3px solid #111; box-shadow:5px 5px 0 #111; padding:8px 13px; font-weight:800; font-size:13px; color:#111; display:flex; justify-content:space-between; transition:transform .5s cubic-bezier(.22,.7,.3,1), opacity .5s; }
