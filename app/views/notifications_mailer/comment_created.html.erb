<h1 style="margin: 0 0 16px; font-size: 22px; color: #183c67;">New comment on your insight</h1>

<p style="margin: 0 0 16px;"><%= actor_name %> commented on <strong><%= @insight_item.title %></strong>:</p>

<blockquote style="margin: 0 0 24px; padding: 12px 16px; border-left: 4px solid #33b8ed; background-color: #f6f8fa; color: #444444;">
  <%= truncate(@comment.body, length: 300) %>
</blockquote>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
  <tr>
    <td style="background-color: #33b8ed; border-radius: 6px;">
      <%= link_to "View Comment", insight_url, style: "display: inline-block; padding: 14px 32px; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none;" %>
    </td>
  </tr>
</table>

<p style="margin: 0; color: #888888; font-size: 14px;"><%= link_to "Manage your notification preferences", preferences_url, style: "color: #888888;" %></p>
