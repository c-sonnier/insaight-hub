<h1 style="margin: 0 0 16px; font-size: 22px; color: #183c67;">New insight in <%= @insight_item.account.name %></h1>

<p style="margin: 0 0 24px;"><%= actor_name %> published <strong><%= @insight_item.title %></strong>.</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
  <tr>
    <td style="background-color: #33b8ed; border-radius: 6px;">
      <%= link_to "View Insight", insight_url, style: "display: inline-block; padding: 14px 32px; color: #ffffff; font-size: 16px; font-weight: 600; text-decoration: none;" %>
    </td>
  </tr>
</table>

<p style="margin: 0; color: #888888; font-size: 14px;"><%= link_to "Manage your notification preferences", preferences_url, style: "color: #888888;" %></p>
